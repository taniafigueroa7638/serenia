# Primero puedes dejar el chatbot en modo de prueba:
AI_PROVIDER=mock

# Cuando tengas la API key de Groq:
# AI_PROVIDER=groq
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo recomendado inicialmente
AI_MODEL=openai/gpt-oss-120b
AI_BASE_URL=https://api.groq.com/openai/v1

# Control de longitud y tiempos
AI_MAX_COMPLETION_TOKENS=700
AI_TIMEOUT_MS=30000

# Límites propios de Serenia para proteger la cuota gratuita
CHAT_REQUESTS_PER_MINUTE=12
AI_DAILY_USER_LIMIT=40

# Recurso local para respuestas de emergencia.
# Si Serenia se usa fuera de Ecuador, cambia este texto.
EMERGENCY_RESOURCE_TEXT=Si estás en Ecuador y hay una emergencia inmediata, comunícate con el ECU 9-1-1.
